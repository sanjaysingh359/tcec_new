# Node / frontend
frontend/node_modules
frontend/dist
frontend/dist-ssr
frontend/*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Java / Maven
# Anchored to the Maven module — a bare "target/" also matches
# frontend/src/pages/Target/ on case-insensitive (Windows/macOS) filesystems.
/backend/target/**
*.class
*.war
*.ear
# Keep the runnable JAR for deployment
!/backend/target/tcec-api-1.0.0.jar

# Environment files
.env
.env.local
.env.*.local

# External config override (contains credentials)
backend/config/

# Database dumps / migration scripts
postgresDb/
mysql_dump.sql
pg_migration.sql

# Temp / scratch files
backend/set
